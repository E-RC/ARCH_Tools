<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geometry Slope Multi" Width="360" SizeToContent="Height"
        MaxHeight="620" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4"
                   Text="Pendiente (%) de cada arista:"/>

        <TextBlock Grid.Row="1" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="#666666"
                   Text="Positivo sube al alejarse de la arista, negativo baja. Usa el mismo signo en todas: los signos opuestos se contradicen."/>

        <ScrollViewer Grid.Row="2" MaxHeight="420"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>

        <Button x:Name="ApplyButton" Grid.Row="3" Content="Aplicar"
                Height="30" Width="100" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsDefault="True" Click="apply_click"/>
    </Grid>
</Window>
