<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link VG - Vista activa" Height="720" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="2,3,2,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0098FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Revit Links - ajustes en simultaneo" FontWeight="Bold" FontSize="16"
                   Foreground="#007ACC" Grid.Row="0"/>
        <TextBlock x:Name="view_name_txt" Text="" Foreground="#CE9178" Margin="0,2,0,10" Grid.Row="1"/>

        <DockPanel Grid.Row="2" LastChildFill="True">
            <TextBlock Text="LINKS A MODIFICAR" FontWeight="Bold" Foreground="#4EC9B0"
                       DockPanel.Dock="Top" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="links_all_btn" Content="Todos" Background="#333333" Width="70" Margin="0,0,8,0"/>
                <Button x:Name="links_none_btn" Content="Ninguno" Background="#333333" Width="70"/>
            </StackPanel>
            <ListBox x:Name="links_lb"/>
        </DockPanel>

        <TextBlock Text="PRESETS (guardados en el modelo)" FontWeight="Bold"
                   Foreground="#4EC9B0" Grid.Row="3" Margin="0,12,0,4"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ComboBox x:Name="preset_cb" Grid.Row="0" Grid.Column="0"/>
            <Button x:Name="preset_apply_btn" Content="Aplicar preset a marcados"
                    Grid.Row="0" Grid.Column="1" Margin="8,3,0,6" Padding="10,3"/>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button x:Name="preset_save_btn" Content="Guardar config. de esta vista como preset..."
                        Background="#333333" Margin="0,0,8,0" Padding="10,4"/>
                <Button x:Name="preset_del_btn" Content="Eliminar" Background="#333333" Padding="10,4"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="AJUSTES (se aplican solo los distintos de 'No cambiar')" FontWeight="Bold"
                   Foreground="#4EC9B0" Grid.Row="5" Margin="0,12,0,4"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Visibilidad:" Grid.Row="0" Grid.Column="0" Width="150" Padding="0,4,0,0"/>
            <ComboBox x:Name="vis_cb" Grid.Row="0" Grid.Column="1"/>

            <Label Content="Halftone:" Grid.Row="1" Grid.Column="0" Padding="0,4,0,0"/>
            <ComboBox x:Name="halftone_cb" Grid.Row="1" Grid.Column="1"/>

            <Label Content="Display Settings:" Grid.Row="2" Grid.Column="0" Padding="0,4,0,0"/>
            <ComboBox x:Name="mode_cb" Grid.Row="2" Grid.Column="1"/>

            <Label Content="Vista vinculada:" Grid.Row="3" Grid.Column="0" Padding="0,4,0,0"/>
            <ComboBox x:Name="linked_view_cb" Grid.Row="3" Grid.Column="1" IsEnabled="False"/>

            <CheckBox x:Name="copy_chk" Content="Copiar configuracion completa desde:"
                      Grid.Row="4" Grid.Column="0" Margin="0,8,10,0"/>
            <ComboBox x:Name="copy_src_cb" Grid.Row="4" Grid.Column="1" Margin="0,6,0,6" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="* Las opciones internas de 'Custom' (fases, categorias...) no son editables por la API de Revit: configurelas una vez en el dialogo y guardelas como preset, o use 'Copiar configuracion desde'."
                       FontSize="10" Foreground="#888888" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>
            <Button x:Name="close_btn" Content="Cerrar" Grid.Column="1" Background="#333333" Width="90"/>
            <Button x:Name="apply_btn" Content="Aplicar" Grid.Column="3" Width="110"/>
        </Grid>
    </Grid>
</Window>
