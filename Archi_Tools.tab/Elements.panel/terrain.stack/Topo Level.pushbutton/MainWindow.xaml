<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topo Level Precisión" Height="220" Width="380"
        WindowStartupLocation="CenterScreen" Background="#F5F5F4"
        FontFamily="Lato, Segoe UI, Helvetica Neue, sans-serif"
        ResizeMode="NoResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="31" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B26E63"/>
            <Setter Property="Foreground" Value="#FFFFF9"/>
            <Setter Property="FontSize" Value="14.6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9A5E54"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#874F47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFF9"/>
            <Setter Property="BorderBrush" Value="#C7C5CD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="18.6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="SelectionBrush" Value="#26B26E63"/>
            <Setter Property="SelectionTextBrush" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#B26E63"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="#F5F5F4" BorderBrush="#C7C5CD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Width="16" Height="16" Margin="10,0,5,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Topo Level Precisión" 
                           Foreground="#333333" FontFamily="Lato Light, Segoe UI Light, sans-serif"
                           VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Button Grid.Column="2" Click="CancelBtn_Click" 
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="40" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" 
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#A1A1A0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#333333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ingrese nivel de precisión (0-10):" Foreground="#333333" FontSize="14.6" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            
            <TextBox x:Name="PrecisionTxt" Grid.Row="1" Text="5" Height="36" Width="100" HorizontalAlignment="Center" Margin="0,5,0,20"/>
            
            <Button x:Name="OkBtn" Grid.Row="3" Content="OK" Width="100" Height="30" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="OkBtn_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
