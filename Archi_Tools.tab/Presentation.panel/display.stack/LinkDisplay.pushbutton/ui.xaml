<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Display Settings - Batch" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="2,3,2,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0098FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="RVT Link Display Settings - Aplicacion por lote" FontWeight="Bold" FontSize="16"
                   Foreground="#007ACC" Margin="0,0,0,12" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: origen + accion + links destino -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="1. ORIGEN (configuracion a copiar)" FontWeight="Bold" Foreground="#4EC9B0" Grid.Row="0"/>
                <StackPanel Grid.Row="1" Margin="0,4,0,8">
                    <Label Content="Vista origen:" Padding="0,0,0,2"/>
                    <ComboBox x:Name="src_view_cb"/>
                    <Label Content="Link origen:" Padding="0,0,0,2"/>
                    <ComboBox x:Name="src_link_cb"/>
                    <TextBlock x:Name="src_mode_txt" Text="" Foreground="#CE9178" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="2. ACCION" FontWeight="Bold" Foreground="#4EC9B0" Grid.Row="2" Margin="0,6,0,0"/>
                <StackPanel Grid.Row="3" Margin="0,2,0,10">
                    <RadioButton x:Name="copy_rb" Content="Copiar configuracion del origen a los destinos" IsChecked="True"/>
                    <RadioButton x:Name="reset_rb" Content="Restablecer destinos a 'By Host View' (quitar overrides)"/>
                </StackPanel>

                <DockPanel Grid.Row="4" LastChildFill="True">
                    <TextBlock Text="3. LINKS DE DESTINO" FontWeight="Bold" Foreground="#4EC9B0" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                    <ListBox x:Name="links_lb"/>
                </DockPanel>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="links_all_btn" Content="Todos" Background="#333333" Width="70" Margin="0,0,8,0"/>
                    <Button x:Name="links_none_btn" Content="Ninguno" Background="#333333" Width="70"/>
                </StackPanel>
            </Grid>

            <!-- Columna derecha: vistas destino -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="4. VISTAS DE DESTINO" FontWeight="Bold" Foreground="#4EC9B0" Grid.Row="0"/>
                <Grid Grid.Row="1" Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="view_filter_txt" Grid.Column="0" ToolTip="Filtrar vistas por nombre"/>
                    <CheckBox x:Name="show_templates_chk" Content="Ver templates" Grid.Column="1"
                              Margin="10,4,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ListBox x:Name="views_lb" Grid.Row="2"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="views_all_btn" Content="Todas" Background="#333333" Width="70" Margin="0,0,8,0"/>
                    <Button x:Name="views_none_btn" Content="Ninguna" Background="#333333" Width="70"/>
                    <TextBlock x:Name="views_count_txt" Text="" Foreground="#888888" Margin="12,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="* Configure primero un link 'modelo' en V/G y uselo como origen. La copia incluye Basics, Model Categories y Annotation Categories."
                       FontSize="10" Foreground="#888888" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>
            <Button x:Name="close_btn" Content="Cerrar" Grid.Column="1" Background="#333333" Width="90"/>
            <Button x:Name="apply_btn" Content="Aplicar" Grid.Column="3" Width="110"/>
        </Grid>
    </Grid>
</Window>
